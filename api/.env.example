GEMINI_API_KEY=your-gemini-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Gemini model id (gemini-flash-latest 404s; check models.list())
GEMINI_MODEL=gemini-3.6-flash
# Optional backup model: the retry goes here when the main model is overloaded or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional faster model for live /refine (see eval_refine.py)
GEMINI_REFINE_MODEL=gemini-3.5-flash-lite
# Optional: ElevenLabs Scribe Realtime speech-to-text. Server-side only; the browser gets single-use tokens.
ELEVENLABS_API_KEY=your-elevenlabs-key
# Allowed web origin(s), comma-separated (Vercel URL + local dev)
WEB_ORIGIN=http://localhost:5173
